class Solution {
    public int[] twoSum(int[] arr, int target) {
        int start=0,end=arr.length-1,sum=0;
        while(start<end){
            sum=arr[start]+arr[end];
            if(sum==target)
            return new int[]{start+1,end+1};
            else if(sum>target)
            end--;
            else start++;
        }
        return new int[]{-1,-1};
    }
}
